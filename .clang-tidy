Checks: >
  -*,
  bugprone-*,
  readability-*,
  performance-*,
  misc-*,
  cppcoreguidelines-*

WarningsAsErrors: ''

HeaderFilterRegex: '^(ex00|ex01|ex02)/'

AnalyzeTemporaryDtors: true

CheckOptions:
  - key: readability-identifier-naming.AllowedIdentifierRegex
    value: '^[A-Za-z_][A-Za-z0-9_]*$'
  - key: cppcoreguidelines-owning-memory
    value: '0'
  - key: cppcoreguidelines-special-member-functions
    value: '0'
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoredValues
    value: '0,1,2,8,10,79'
  - key: readability-magic-numbers.IgnorePowersOf2
    value: '1'

# Disable modernize checks unsuitable for C++98
EnableStaticAnalyzer: true
ChecksDisabled:
  - modernize-*
  - readability-avoid-const-params-in-decls
  - readability-identifier-length
  - cppcoreguidelines-pro-type-vararg
